# Public DNS name pointing to this host. Caddy obtains and renews TLS automatically.
SCYTALE_DOMAIN=rpc.example.com

# Create the hash with:
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'replace-me'
RPC_BASIC_AUTH_USER=scytale-rpc
RPC_BASIC_AUTH_HASH=REPLACE_WITH_CADDY_GENERATED_HASH
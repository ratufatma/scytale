{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Scytale Studio",
    "version": "0.1.0",
    "identifier": "com.scytale.studio",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Scytale Studio",
                "width": 1440,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 680,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "icon": [
            "icons/icon.png",
            "icons/icon.ico"
        ],
        "targets": "all"
    }
}